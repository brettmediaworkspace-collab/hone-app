rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── appsplosh collections ─────────────────────────────────────────
    // Preserves the previous behaviour (any signed-in user) exactly, but
    // scoped to the collections appsplosh actually uses instead of a
    // database-wide catch-all. Tightening these further is a separate,
    // appsplosh-side task.
    match /apps/{id} {
      allow read, write: if request.auth != null;
    }
    match /users/{id} {
      allow read, write: if request.auth != null;
    }
    match /reviews/{id} {
      allow read, write: if request.auth != null;
    }
    match /support_inquiries/{id} {
      allow read, write: if request.auth != null;
    }
    match /mail/{id} {
      allow read, write: if request.auth != null;
    }

    // ── HONE app data ─────────────────────────────────────────────────
    // One doc per user; users touch only their own. The `subscription`
    // field is written exclusively by the payments webhook (Admin SDK
    // bypasses rules), so clients can never grant themselves Pro.
    match /hone_users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['subscription']);
    }
  }
}
